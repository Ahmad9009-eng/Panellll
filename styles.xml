<?xml version="1.0" encoding="utf-8"?>
<resources>
    
    <style name="Theme.SteeringWheel" parent="Theme.AppCompat.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">#1a1a1a</item>
        <item name="colorPrimaryDark">#0a0a0a</item>
        <item name="colorAccent">#00d4ff</item>
        
        <!-- Background -->
        <item name="android:windowBackground">#0a0a0a</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        
        <!-- Status bar styling -->
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        
        <!-- Text colors -->
        <item name="android:textColorPrimary">#ffffff</item>
        <item name="android:textColorSecondary">#888888</item>
    </style>

    <!-- Button style -->
    <style name="SteeringButtonStyle" parent="Widget.AppCompat.Button">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">#1a4d7f</item>
        <item name="android:padding">10dp</item>
    </style>

    <!-- Text style for steering value -->
    <style name="SteeringValueText">
        <item name="android:textColor">#00d4ff</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
